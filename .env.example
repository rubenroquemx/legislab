# Correo del Superadmin Maestro (Inmutable y con acceso total al panel /admin)
SUPERADMIN_EMAIL=usrubenroque@gmail.com

# Contraseña del Superadmin Maestro para acceso directo con correo y contraseña
SUPERADMIN_PASSWORD=TuContraseñaSegura2026!

# (Opcional) Correo público para validaciones en el cliente
NEXT_PUBLIC_SUPERADMIN_EMAIL=usrubenroque@gmail.com

# Clave secreta para la sesión de NextAuth (JWT)
NEXTAUTH_SECRET=legislab-secret-key-2026-auth-token-superadmin

# URL base de la aplicación (en producción: https://tu-dominio.com)
NEXTAUTH_URL=http://localhost:3000

